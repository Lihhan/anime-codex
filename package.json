{
  "name": "anime-codex",
  "version": "0.8.1",
  "description": "A character-driven Windows and macOS desktop client for the real Codex App Server",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke:backend": "node scripts/smoke-backend.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "smoke:customization": "node scripts/smoke-customization.mjs",
    "smoke:desktop": "node scripts/smoke-desktop-real.mjs",
    "smoke:background": "node scripts/smoke-background.mjs",
    "smoke:connection": "node scripts/smoke-connection.mjs",
    "smoke:play": "node scripts/smoke-play.mjs",
    "smoke:arcade": "node scripts/smoke-arcade.mjs",
    "smoke:gal": "node scripts/smoke-gal.mjs",
    "smoke:gal-real": "node scripts/smoke-gal-real.mjs",
    "dist:mac": "npm run build && node scripts/build-input-pulse.mjs && electron-builder --mac dmg zip --publish never",
    "dist:mac:arm64": "npm run build && node scripts/build-input-pulse.mjs arm64 && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:x64": "npm run build && node scripts/build-input-pulse.mjs x64 && electron-builder --mac dmg zip --x64 --publish never",
    "smoke:native": "node scripts/smoke-native.mjs",
    "smoke:presets": "node scripts/smoke-presets.mjs",
    "smoke:presets-real": "node scripts/smoke-presets-real.mjs",
    "smoke:dock": "node scripts/smoke-dock.mjs",
    "smoke:chat-real": "node scripts/smoke-chat-real.mjs",
    "smoke:claude": "node scripts/smoke-claude-ui.mjs",
    "smoke:claude-real": "node scripts/smoke-claude-real.mjs",
    "smoke:agent": "node scripts/smoke-agent.mjs",
    "smoke:workbench": "node scripts/smoke-workbench.mjs",
    "smoke:studio": "node scripts/smoke-studio.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "smoke:companion": "node scripts/smoke-companion.mjs",
    "smoke:companion-real": "node scripts/smoke-companion-real.mjs",
    "smoke:input": "node scripts/smoke-input-pulse.mjs",
    "smoke:portable-real": "node scripts/smoke-portable-real.mjs",
    "smoke:settings": "node scripts/smoke-settings.mjs",
    "smoke:audio": "node scripts/smoke-voice-clips.mjs",
    "smoke:packs": "node scripts/smoke-builtin-packs.mjs",
    "smoke:locales-overlay": "node scripts/smoke-locales-overlay.mjs"
  },
  "build": {
    "appId": "io.animecodex.desktop",
    "productName": "Anime Codex",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "characters/**/*",
      "package.json",
      "third_party/**/*",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "scripts/native-probe.cjs"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "files": [
        "dist/**/*",
        "electron/**/*",
        "shared/**/*",
        "characters/**/*",
        "package.json",
        "third_party/**/*",
        "THIRD_PARTY_NOTICES.md",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "scripts/native-probe.cjs",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node-intel/**"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Anime-Codex-${version}-win-x64.${ext}"
    },
    "directories": {
      "output": "release/v0.8.1"
    },
    "asarUnpack": [
      "electron/background-worker.cjs",
      "shared/background-math.cjs",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/pngjs/**",
      "electron/inference-runtime.cjs",
      "node_modules/onnxruntime-node-intel/**",
      "electron/native/input-pulse.cs"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "14.0.0",
      "artifactName": "Anime-Codex-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "files": [
        "dist/**/*",
        "electron/**/*",
        "shared/**/*",
        "characters/**/*",
        "package.json",
        "third_party/**/*",
        "THIRD_PARTY_NOTICES.md",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "scripts/native-probe.cjs",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node-intel/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node-intel/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node-intel/bin/napi-v6/darwin/arm64/**"
      ],
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "build/native/input-pulse-mac",
          "to": "helpers/input-pulse"
        }
      ]
    }
  },
  "dependencies": {
    "onnxruntime-node": "1.31.1",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "vite": "8.3.6"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "adm-zip": "0.6.1"
  },
  "author": "Anime Codex contributors",
  "optionalDependencies": {
    "onnxruntime-node-intel": "npm:onnxruntime-node@1.23.2"
  }
}
