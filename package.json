{
  "name": "anime-codex",
  "version": "0.2.2",
  "description": "A character-driven Windows desktop client for the real Codex App Server",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke:backend": "node scripts/smoke-backend.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "smoke:customization": "node scripts/smoke-customization.mjs",
    "smoke:desktop": "node scripts/smoke-desktop-real.mjs",
    "smoke:background": "node scripts/smoke-background.mjs"
  },
  "build": {
    "appId": "io.animecodex.desktop",
    "productName": "Anime Codex",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "characters/**/*",
      "package.json",
      "third_party/**/*",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release/v0.2.2"
    },
    "asarUnpack": [
      "electron/background-worker.cjs",
      "shared/background-math.cjs",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/pngjs/**"
    ]
  },
  "dependencies": {
    "onnxruntime-node": "1.31.1",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "vite": "8.3.6"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "author": "Anime Codex contributors"
}
