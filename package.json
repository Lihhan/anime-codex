{
  "name": "anime-codex",
  "version": "0.1.0",
  "description": "A character-driven Windows desktop client for the real Codex App Server",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke:backend": "node scripts/smoke-backend.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "dist:win": "npm run build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "io.animecodex.desktop",
    "productName": "Anime Codex",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "characters/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "vite": "8.3.6"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
